# Copy this file to .env and fill it in. Never commit .env.

# From https://console.typesafe.ai/
TYPESAFE_API_KEY=

# Optional: read your own mailbox (python -m inbox_queue imap).
# For Gmail: turn on 2-step verification, then create an app password at
# https://myaccount.google.com/apppasswords, then store it in your keychain with:
#   uv run python -m inbox_queue save-password
IMAP_HOST=imap.gmail.com
IMAP_USER=
MY_NAME=
